---
import Base from '../layouts/Base.astro';
import { siteTitle } from '../data/profile';

/**
 * Vercel serves this page's build output (`/404.html`) with a real HTTP 404 for
 * any unmatched path. The body is kept short and includes the recovery routes
 * verbatim as Markdown so a non-JS agent that lands here can find its way to the
 * sitemap, llms.txt, or an index instead of concluding the path exists.
 */
const recoveryMarkdown = `# 404 — Not Found

That path does not exist on ${siteTitle}.

Where to look next:

- [/sitemap.xml](/sitemap.xml) — every indexable URL on this site
- [/llms.txt](/llms.txt) — entry point for agents, with when-to-use guidance
- [/agents.md](/agents.md) — full profile as Markdown
- [/blog/](/blog/) — all posts
- [/weeknotes/](/weeknotes/) — weekly notes
- [/shelf/](/shelf/) — books, films, albums, articles
- [/about/](/about/) · [/contact/](/contact/) — who this is and how to reach them

Any HTML page here has a Markdown twin: append \`.md\` to its URL, or send
\`Accept: text/markdown\`.
`;

const links = [
  { href: '/sitemap.xml', label: '/sitemap.xml', note: 'every indexable URL' },
  { href: '/llms.txt', label: '/llms.txt', note: 'entry point for agents' },
  { href: '/agents.md', label: '/agents.md', note: 'full profile as Markdown' },
  { href: '/blog/', label: '/blog/', note: 'all posts' },
  { href: '/weeknotes/', label: '/weeknotes/', note: 'weekly notes' },
  { href: '/shelf/', label: '/shelf/', note: 'books, films, albums, articles' },
  { href: '/about/', label: '/about/', note: 'who this is' },
  { href: '/contact/', label: '/contact/', note: 'how to reach them' },
];
---

<Base
  title={`404 — Not Found · ${siteTitle}`}
  ogTitle='404 — Not Found'
  description='That path does not exist. Start from the sitemap, llms.txt, or an index page.'
>
  <div class='mx-auto max-w-2xl py-10'>
    <h1 class='mb-3 text-2xl font-semibold text-neutral-900 dark:text-gray-100'>
      404 — Not Found
    </h1>
    <p class='mb-8 text-neutral-600 dark:text-gray-400'>
      That path does not exist on {siteTitle}. Here is where to look next.
    </p>

    <ul class='mb-10 space-y-2'>
      {links.map((link) => (
        <li class='text-sm sm:text-base'>
          <a href={link.href} class='font-medium text-blue-600 hover:underline dark:text-blue-400'>
            {link.label}
          </a>
          <span class='text-neutral-500 dark:text-gray-500'> — {link.note}</span>
        </li>
      ))}
    </ul>

    <h2 class='mb-2 text-sm font-semibold uppercase tracking-normal text-neutral-500 dark:text-gray-500'>
      Same thing as Markdown
    </h2>
    <pre
      class='overflow-x-auto rounded border border-neutral-300 bg-white p-4 text-xs leading-relaxed text-neutral-700 dark:border-neutral-700 dark:bg-neutral-900 dark:text-gray-300'><code>{recoveryMarkdown}</code></pre>
  </div>
</Base>
